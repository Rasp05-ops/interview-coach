# Shared by the Next.js app and API routes
GROQ_API_KEY=replace_with_groq_key

# Required by the Next.js app for signing secure login cookies (generate with: openssl rand -base64 48)
AUTH_SECRET=replace_with_a_random_secret_at_least_32_characters

# Required in production; use hosted PostgreSQL shared by all Vercel instances
# DATABASE_URL=postgresql://user:password@host:5432/database

# Used by the Next.js server to proxy /api/agent requests to Render
AGENT_SERVICE_URL=https://your-agent.onrender.com

# Used by the browser for the realtime WebSocket connection
NEXT_PUBLIC_AGENT_WS_URL=wss://your-agent.onrender.com

# Optional dedicated Smart Turn endpoint. If omitted, the agent WebSocket host is reused.
NEXT_PUBLIC_EOT_WS_URL=wss://your-agent.onrender.com/ws/eot

# Optional local-only settings
# PYTHON_BIN=/absolute/path/to/interview-coach/.venv/bin/python
# EOT_MODEL_PATH=/absolute/path/to/smart-turn-v3-cpu.onnx
