# Shared by the Next.js app and API routes
GROQ_API_KEY=replace_with_groq_key

# Used by the Next.js server to proxy /api/agent requests to Railway
AGENT_SERVICE_URL=https://your-agent.up.railway.app

# Used by the browser for the realtime WebSocket connection
NEXT_PUBLIC_AGENT_WS_URL=wss://your-agent.up.railway.app

# Optional dedicated Smart Turn endpoint. If omitted, the agent WebSocket host is reused.
NEXT_PUBLIC_EOT_WS_URL=wss://your-agent.up.railway.app/ws/eot

# Optional local-only settings
# PYTHON_BIN=/absolute/path/to/interview-coach/.venv/bin/python
# EOT_MODEL_PATH=/absolute/path/to/smart-turn-v3-cpu.onnx
